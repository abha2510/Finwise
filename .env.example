# Copy to .env and fill in. Never commit .env.

# --- Okta (see docs/OKTA_SETUP.md) ---
# Custom authorization server issuer, e.g. https://dev-123456.okta.com/oauth2/default
OKTA_ISSUER=
# Client ID of the OIDC Single-Page App
OKTA_CLIENT_ID=
# Audience configured on the authorization server
OKTA_AUDIENCE=api://finwise

# --- Database ---
POSTGRES_DB=finwise
POSTGRES_USER=finwise
POSTGRES_PASSWORD=change-me

# --- URLs ---
FRONTEND_ORIGIN=http://localhost:5173
